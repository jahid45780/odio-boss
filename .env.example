# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NEXT_PUBLIC_API_URL: Optional external Express backend URL (defaults to built-in /api/v1).
# NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Authentication & Security
JWT_SECRET="replace_with_a_strong_32_char_secret"
JWT_EXPIRES_IN="7d"

# Optional Cloudinary Credentials (falls back to local /public/uploads when unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Admin Seeding Credentials
ADMIN_NAME="SONIQ Administrator"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
